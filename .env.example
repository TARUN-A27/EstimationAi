# Oracle SCM
SCM_DB_HOST=db.example.invalid
SCM_DB_PORT=1521
SCM_DB_SERVICE=replace_me
SCM_DB_USER=replace_me
SCM_DB_PASSWORD=

# Required non-null ENQUIRYDOCUMENT metadata
SCM_ENTRY_REMARKS=YOUR_NAME
# Optional. If omitted, the web request IP is stored.
# SCM_SYSTEM_NAME=estimation-app

# Azure AI Content Understanding (PDFs are submitted directly)
# The selected analyzer/router must return DocumentType and EstimationNumbers.
# PO output must also define PartyName and OrderLines with EstimateNumber,
# ReferenceNumber, RequiredQuantity, CountName/Count, Certification and NetRate.
CONTENTUNDERSTANDING_ENDPOINT=https://your-resource.services.ai.azure.com/
CONTENTUNDERSTANDING_KEY=replace_me
# Compatibility fallback used when no workflow-specific analyzer is set.
CONTENTUNDERSTANDING_ANALYZER_ID=replace_me
# Optional router or workflow-specific analyzers. A workflow-specific value
# takes precedence, followed by the router and then the compatibility value.
# CONTENTUNDERSTANDING_ROUTER_ANALYZER_ID=replace_me
# CONTENTUNDERSTANDING_ESTIMATION_ANALYZER_ID=replace_me
# CONTENTUNDERSTANDING_MIXING_ANALYZER_ID=replace_me
# CONTENTUNDERSTANDING_PO_ANALYZER_ID=replace_me
CONTENTUNDERSTANDING_REQUEST_TIMEOUT_SECONDS=30
CONTENTUNDERSTANDING_ANALYSIS_TIMEOUT_SECONDS=300

# Optional on Linux when pdftoppm is already on PATH.
# POPPLER_PATH=/usr/bin
# ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_21_19

# Safety limits
MAX_UPLOAD_BYTES=104857600
FLASK_DEBUG=0
